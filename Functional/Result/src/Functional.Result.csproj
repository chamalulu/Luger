<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup Label="Build">
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>8</AnalysisLevel>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <LangVersion>12.0</LangVersion>
    </PropertyGroup>

    <PropertyGroup Label="Information">
        <AssemblyName>Luger.Functional.Result</AssemblyName>
        <RootNamespace>Luger.Functional</RootNamespace>
        <Description>A composable result type waiting to be retired when we have DUs in C#. Still waiting...</Description>
        <Authors>Henrik Lundberg</Authors>
        <Product>Luger</Product>
        <Copyright>© 2025 Henrik Lundberg</Copyright>
    </PropertyGroup>

    <PropertyGroup Label="Versioning">
        <VersionPrefix>1.0.0</VersionPrefix>
        <!-- Set empty suffix when API is stable -->
        <VersionSuffix>beta</VersionSuffix>
        <PackageReleaseNotes>First rewrite from playground</PackageReleaseNotes>
    </PropertyGroup>

    <PropertyGroup Label="Packaging">
        <PackageTags>result, either, functional, LINQ</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
    
</Project>